/dts-v1/;

#include "ipq5018.dtsi"
#include "ipq5018-ess.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Linksys FGW5500";
	compatible = "linksys,fgw5500", "qcom,ipq5018";

	aliases {
		led-boot = &led_net_b;
		led-failsafe = &led_net_r;
		led-running = &led_net_b;
		led-upgrade = &led_net_r;
		serial0 = &blsp1_uart1;
	};

	chosen {
		bootargs-append = " root=/dev/ubiblock0_1 swiotlb=1 coherent_pool=2M";
		stdout-path = "serial0:115200n8";
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		button-power {
			label = "power";
			gpios = <&tlmm 0 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_POWER>;
			debounce-interval = <60>;
		};

		button-reset {
			label = "reset";
			gpios = <&tlmm 31 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};

		button-wps {
			label = "wps";
			gpios = <&tlmm 38 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
			debounce-interval = <60>;
		};
	};

	/*
	 * The three front-panel LEDs (bottom: 5G/4G/ethernet/alarm,
	 * middle: WiFi, top: VoIP) are driven by an SN74HC595 shift
	 * register bit-banged over two GPIOs (SPI-GPIO, no chip select).
	 * Bit map as shipped in the stock device tree (register 0 is the
	 * first bit clocked out on QS0, then QS1 -> QS7):
	 *   bit0 = phone blue, bit1 = network blue, bit2 = network green,
	 *   bit3 = network red, bit4 = wifi green, bit5 = wifi blue,
	 *   bit6 = phone green, bit7 = unused.
	 */
	led_spi {
		compatible = "spi-gpio";
		pinctrl-0 = <&led_spi_pins>;
		pinctrl-names = "default";
		#address-cells = <1>;
		#size-cells = <0>;

		sck-gpios = <&tlmm 22 GPIO_ACTIVE_HIGH>;
		mosi-gpios = <&tlmm 35 GPIO_ACTIVE_HIGH>;

		led_gpio: led_gpio@0 {
			compatible = "fairchild,74hc595";
			reg = <0>;
			gpio-controller;
			#gpio-cells = <2>;
			registers-number = <1>;
			spi-max-frequency = <1000000>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&led_spi_pins>;
		pinctrl-names = "default";

		/* Bottom LED: blue, links on 5G NSA/SA */
		led_net_b: led-net-blue {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&led_gpio 1 GPIO_ACTIVE_HIGH>;
		};

		/* Bottom LED: green, links on LTE/3G or ethernet WAN */
		led_net_g: led-net-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			gpios = <&led_gpio 2 GPIO_ACTIVE_HIGH>;
		};

		/* Bottom LED: red, alarm (system, no SIM, no network, failed boot) */
		led_net_r: led-net-red {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			gpios = <&led_gpio 3 GPIO_ACTIVE_HIGH>;
		};

		/* Middle LED: green, WiFi on, LTE/3G WAN mode (blinking) */
		led_wifi_g: led-wifi-green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_WLAN;
			gpios = <&led_gpio 4 GPIO_ACTIVE_HIGH>;
			/* stay off until hostapd turns the radio on */
			default-state = "off";
		};

		/* Middle LED: blue, WiFi on, 5G/ethernet WAN mode (blinking) */
		led_wifi_b: led-wifi-blue {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_WLAN;
			gpios = <&led_gpio 5 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		/* Top LED: green, VoIP (SIP/VoLTE) active */
		led_phone_g: led-phone-green {
			color = <LED_COLOR_ID_GREEN>;
			function = "phone";
			gpios = <&led_gpio 6 GPIO_ACTIVE_HIGH>;
		};

		/* Top LED: blue, VoIP (SIP/VoLTE) active */
		led_phone_b: led-phone-blue {
			color = <LED_COLOR_ID_BLUE>;
			function = "phone";
			gpios = <&led_gpio 0 GPIO_ACTIVE_HIGH>;
		};
	};
};

/*
 * =================================================================
 *     _______________________             _______________________
 *    |        IPQ5018        |           |        QCA8337        |
 *    | +------+   +--------+ |           | +--------+   +------+ |
 *    | | MAC0 |---| GE Phy | |           | |  Phy0  |---| MAC6 | |
 *    | +------+   +--------+ |           | +--------+   +------+ |
 *    | +------+   +--------+ |           | +--------+   +------+ |
 *    | | MAC1 |---| Uniphy |-+- SGMII ---+ | SerDes |---| MAC2 | |
 *    | +------+   +--------+ |           | +--------+   +------+ |
 *    |_______________________|           |_______________________|
 *
 * GMAC0 -> internal GE PHY (MDIO0, address 7) -> WAN RJ45.
 * GMAC1 -> UNIPHY0 SGMII -> QCA8337 CPU port -> LAN1/LAN2.
 * =================================================================
 */

&uniphy0 {
	status = "okay";

	assigned-clocks = <&uniphy0 UNIPHY_CLK_REF>;
	assigned-clock-rates = <UNIPHY_REFCLK_25MHZ>;
};

// MAC0 --- internal GE PHY (MDIO0 addr 7) --- WAN
&gmac0 {
	status = "okay";

	label = "wan";

	nvmem-cells = <&macaddr_gmac0 0>;
	nvmem-cell-names = "mac-address";
};

// MAC1 ---SGMII---> QCA8337 CPU port
&gmac1 {
	status = "okay";

	phy-mode = "sgmii";

	nvmem-cells = <&macaddr_gmac1 0>;
	nvmem-cell-names = "mac-address";

	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

&mdio0 {
	status = "okay";
};

&mdio1 {
	status = "okay";

	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";
	reset-gpios = <&tlmm 39 GPIO_ACTIVE_LOW>;

	// QCA8337 Phy1 -> LAN2
	qca8337_1: ethernet-phy@1 {
		reg = <1>;
	};

	// QCA8337 Phy2 -> LAN1
	qca8337_2: ethernet-phy@2 {
		reg = <2>;
	};

	// QCA8337 switch (MDIO addr 0x1c)
	switch1: ethernet-switch@28 {
		compatible = "qca,qca8337";
		reg = <28>;
		#address-cells = <1>;
		#size-cells = <0>;

		ethernet-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			switch1cpu: ethernet-port@0 {
				reg = <0>;
				label = "cpu";
				phy-mode = "sgmii";
				ethernet = <&gmac1>;
				qca,sgmii-enable-pll;

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};

			/* Phy0/3/4 are not wired on this board: LAN1/LAN2 only */
			ethernet-port@1 {
				reg = <1>;
				phy-handle = <&qca8337_1>;

				leds {
					#address-cells = <1>;
					#size-cells = <0>;

					/* LAN2 green LED */
					led@0 {
						reg = <0>;
						color = <LED_COLOR_ID_GREEN>;
						function = LED_FUNCTION_LAN;
						default-state = "keep";
					};
				};
			};

			ethernet-port@2 {
				reg = <2>;
				phy-handle = <&qca8337_2>;

				leds {
					#address-cells = <1>;
					#size-cells = <0>;

					/* LAN1 green LED */
					led@0 {
						reg = <0>;
						color = <LED_COLOR_ID_GREEN>;
						function = LED_FUNCTION_LAN;
						default-state = "keep";
					};
				};
			};
		};
	};
};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board_clk {
	clock-div = <4>;
	clock-mult = <1>;
};

&blsp1_uart1 {
	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";

	status = "okay";
};

&prng {
	status = "okay";
};

&qfprom {
	status = "okay";
};

&qpic_bam {
	status = "okay";
};

&qpic_nand {
	pinctrl-0 = <&qpic_pins>;
	pinctrl-names = "default";

	status = "okay";

	nand@0 {
		compatible = "spi-nand";
		reg = <0>;

		nand-ecc-engine = <&qpic_nand>;
		nand-ecc-strength = <4>;
		nand-ecc-step-size = <512>;
		nand-bus-width = <8>;

		partitions {
			compatible = "qcom,smem-part";

			partition-0-art {
				label = "0:art";
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					/*
					 * Stock firmware carries placeholder factory
					 * MACs in ART (00:03:7f:12:34:56..); the
					 * per-unit addresses live in the U-Boot
					 * environment (ethaddr/eth1addr). We read the
					 * ART "mac-base" cells as fallback only.
					 */
					macaddr_gmac0: macaddr@0 {
						compatible = "mac-base";
						#nvmem-cell-cells = <1>;
						reg = <0x0 0x6>;
					};

					macaddr_gmac1: macaddr@6 {
						compatible = "mac-base";
						#nvmem-cell-cells = <1>;
						reg = <0x6 0x6>;
					};

					caldata_ipq5018: calibration@1000 {
						reg = <0x1000 0x20000>;
					};

					caldata_qcn9074: calibration@26800 {
						reg = <0x26800 0x20000>;
					};
				};
			};
		};
	};
};

&tlmm {
	mdio1_pins: mdio-state {
		mdc-pins {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio-pins {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	led_spi_pins: led-spi-pins {
		pins = "gpio22", "gpio35";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	button_pins: button-pins {
		pins = "gpio0", "gpio31", "gpio38";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	qpic_pins: qpic-state {
		clock-pins {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cs-pins {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};

		data-pins {
			pins = "gpio4", "gpio5", "gpio6", "gpio7";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};

	serial_0_pins: uart0-state {
		rx-pins {
			pins = "gpio20";
			function = "blsp0_uart0";
			drive-strength = <8>;
			bias-pull-up;
		};

		tx-pins {
			pins = "gpio21";
			function = "blsp0_uart0";
			drive-strength = <8>;
			bias-disable;
		};
	};

	/* Modem control lines, driven high by the stock bootloader too */
	mdm-pins {
		gpio25-pin {
			pins = "gpio25";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
			output-high;
		};

		gpio32-pin {
			pins = "gpio32";
			function = "gpio";
			drive-strength = <8>;
			output-high;
		};
	};

	/* Modem power rail: no consumer, hold it high so the RM520N stays up */
	modem-power-hog {
		gpio-hog;
		gpios = <27 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "modem-power";
	};
};

&usbphy0 {
	status = "okay";
};

&usb {
	#address-cells = <1>;
	#size-cells = <0>;

	phys = <&usbphy0>;
	phy-names = "usb2-phy";
	dr_mode = "host";
	qcom,select-utmi-as-pipe-clk;

	status = "okay";

	usb_port1: port@1 {
		reg = <1>;
		#trigger-source-cells = <0>;
	};
};

/* PCIe RC0 (pcie@80000000): Quectel RM520N-GL 5G modem in MHI mode */
&pcie1_phy {
	status = "okay";
};

&pcie1 {
	status = "okay";

	perst-gpios = <&tlmm 18 GPIO_ACTIVE_LOW>;
	wake-gpios = <&tlmm 19 GPIO_ACTIVE_HIGH>;
};

&pcie0_phy {
	status = "okay";
};

/* PCIe RC1 (pcie@a0000000): QCN9074 5 GHz radio */
&pcie0 {
	status = "okay";

	perst-gpios = <&tlmm 15 GPIO_ACTIVE_LOW>;

	pcie@0 {
		wifi@0,0 {
			status = "okay";

			/* QCN9074: ath11k lacks DT compatible for PCI cards */
			compatible = "pci17cb,1104";
			reg = <0x00010000 0 0 0 0>;

			qcom,calibration-variant = "Linksys-FGW5500";

			nvmem-cells = <&caldata_qcn9074>, <&macaddr_gmac1 3>;
			nvmem-cell-names = "calibration", "mac-address";
		};
	};
};

&q6v5_wcss {
	firmware-name = "ath11k/IPQ5018/hw1.0/q6_fw.mdt",
			"ath11k/IPQ5018/hw1.0/m3_fw.mdt";
};

&wifi {
	status = "okay";

	qcom,rproc = <&q6v5_wcss>;
	qcom,calibration-variant = "Linksys-FGW5500";
	qcom,ath11k-fw-memory-mode = <1>;

	nvmem-cells = <&caldata_ipq5018>, <&macaddr_gmac1 2>;
	nvmem-cell-names = "calibration", "mac-address";
};
